---
import {
    FaApple,
    FaLinux,
    FaRedhat,
    FaUbuntu,
    FaWindows,
} from "react-icons/fa";
import { type AllSupportedOS } from "../Utitls/Config";
import type { IconType } from "react-icons";

interface Props {
    Title?: String;
    Link?: string | URL | null | undefined;
    NewTab?: boolean;
    ConfiguredIcon?: AllSupportedOS;
}

const { Title, Link, NewTab, ConfiguredIcon } = Astro.props;

const Icons: Record<AllSupportedOS, IconType> = {
    Windows: FaWindows,
    LinuxAppImage: FaLinux,
    LinuxDeb: FaUbuntu,
    LinuxRpm: FaRedhat,
    LinuxTar: FaLinux,
    MacArm: FaApple,
    MacIntel: FaApple,
    MacTar: FaApple,
};

const SelectedIcon = ConfiguredIcon ? Icons[ConfiguredIcon] : null;
---

<div
    class="bg-linear-to-r backdrop-blur-[1px] outline-1 hover:outline-2 outline-blue-700/70 from-blue-600 from-10% via-blue-700/70 via-40% hover:via-blue-700/90 to-blue-600 p-2 rounded-md text-white transition duration-300 ease-in-out"
>
    <div>
        <a
            href={Link || null}
            target={NewTab ? "_blank" : "_self"}
            class="h-full w-full flex items-center justify-center gap-1"
        >
            <slot />
            {SelectedIcon && <SelectedIcon />}
            {Title}
        </a>
    </div>
</div>
